---
import { isActiveNav, NAV_ITEMS } from "../lib/nav.ts";
import NavIconSvg from "./NavIconSvg.astro";
import ThemeToggle from "./ThemeToggle.astro";

const AVATAR_URL = "https://github.com/daitasu.png";
const { pathname } = Astro.url;
---

<header class="sidenav">
  <a class="brand" href="/">
    <img class="avatar" src={AVATAR_URL} alt="" width="40" height="40" />
    <span class="name">daitasu</span>
  </a>
  <nav class="nav" aria-label="サイト内ナビゲーション">
    <ul>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              class:list={["nav-link", { active: isActiveNav(item.href, pathname) }]}
              href={item.href}
              aria-current={isActiveNav(item.href, pathname) ? "page" : undefined}
            >
              <NavIconSvg icon={item.icon} />
              <span>{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="footer">
    <ThemeToggle />
  </div>
</header>

<style>
  /* モバイル: 上部バー（ナビは横スクロール）。md(960px) 以上: 左固定のサイドナビ */
  .sidenav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }

  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 2px solid var(--color-accent-soft);
  }

  .name {
    display: none;
  }

  .nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border-radius: 10px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.16s ease, background-color 0.16s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  /* 狭い画面ではラベルだけにして項目数が増えても横スクロールで収める */
  .nav-link :global(svg) {
    display: none;
  }

  .nav-link.active {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .footer {
    flex-shrink: 0;
  }

  @media (min-width: 576px) {
    .name {
      display: inline;
    }

    .nav-link :global(svg) {
      display: block;
    }
  }

  @media (min-width: 960px) {
    .sidenav {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2rem;
      width: var(--sidebar-width);
      padding: 2rem 1.25rem;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }

    .avatar {
      width: 2.75rem;
      height: 2.75rem;
    }

    .name {
      font-size: 1.15rem;
    }

    .nav {
      overflow: visible;
    }

    .nav ul {
      flex-direction: column;
    }

    .nav-link {
      padding: 0.6rem 0.8rem;
      font-size: 0.95rem;
    }

    .footer {
      margin-top: auto;
    }
  }
</style>
