---
import type { NavIcon } from "../lib/nav.ts";

type Props = {
  icon: NavIcon;
};

const { icon } = Astro.props;

// lucide 相当の 24px ストロークアイコン（外部依存を増やさないよう path を直接持つ）
const PATHS: Record<NavIcon, string[]> = {
  home: ["M3 10.5 12 3l9 7.5", "M5 9.5V21h14V9.5", "M9.5 21v-6h5v6"],
  resume: ["M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z", "M14 3v5h5", "M8.5 13h7", "M8.5 17h5"],
  talks: ["M3 4h18", "M4.5 4v10a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V4", "M12 15v4", "M8.5 21 12 19l3.5 2"],
};
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {PATHS[icon].map((d) => <path d={d} />)}
</svg>
